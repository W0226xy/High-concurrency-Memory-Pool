{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: 构建内存池测试",
            "command": "D:\\w64devkit\\w64devkit\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-pthread",
                "${workspaceFolder}\\UnitTest.cpp",
                "${workspaceFolder}\\ThreadCache.cpp",
                "${workspaceFolder}\\CentralCache.cpp",
                "${workspaceFolder}\\PageCache.cpp",
                "-o",
                "${workspaceFolder}\\UnitTest.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用 Win64DevKit 构建内存池测试"
        }
    ]
}